+
+mod spike {
+    use objc2::rc::Retained;
+    use objc2::runtime::AnyObject;
+    use objc2::msg_send;
+    use objc2_core_graphics::{
+        CGBitmapInfo, CGColorRenderingIntent, CGColorSpace, CGDataProvider, CGImage, CGImageAlphaInfo, CGImageByteOrderInfo,
+        CGImageComponentInfo, CGImagePixelFormatInfo,
+    };
+    use objc2_quartz_core::{CALayer, CATransaction};
+    use std::ffi::c_void;
+    use std::ptr::NonNull;
+    use winit::raw_window_handle::{HasWindowHandle, RawWindowHandle};
+    use winit::window::Window;
+
+    unsafe extern "C-unwind" fn release(_info: *mut c_void, data: NonNull<c_void>, size: usize) {
+        let slice = std::ptr::slice_from_raw_parts_mut(data.cast::<u32>().as_ptr(), size / 4);
+        drop(unsafe { Box::from_raw(slice) })
+    }
+
+    pub fn set_mask(window: &Window, rects: Option<Vec<(i16, i16, u16, u16)>>, size: (i32, i32)) -> Result<(), String> {
+        let Ok(handle) = window.window_handle() else { return Ok(()) };
+        let RawWindowHandle::AppKit(h) = handle.as_raw() else { return Ok(()) };
+        let view: &AnyObject = unsafe { h.ns_view.cast().as_ref() };
+        let layer: Option<Retained<CALayer>> = unsafe { msg_send![view, layer] };
+        let Some(layer) = layer else { return Err("view has no layer".into()) };
+        CATransaction::begin();
+        CATransaction::setDisableActions(true);
+        match rects {
+            None => unsafe { layer.setMask(None) },
+            Some(rects) => {
+                let (w, h) = (size.0.max(1) as usize, size.1.max(1) as usize);
+                let mut px = vec![0u32; w * h].into_boxed_slice();
+                for (x, y, rw, rh) in rects {
+                    for yy in (y as usize)..((y as usize + rh as usize).min(h)) {
+                        for xx in (x as usize)..((x as usize + rw as usize).min(w)) {
+                            px[yy * w + xx] = 0xff00_0000;
+                        }
+                    }
+                }
+                let len = px.len() * 4;
+                let data = Box::into_raw(px).cast::<c_void>();
+                let provider = unsafe { CGDataProvider::with_data(std::ptr::null_mut(), data, len, Some(release)) }.ok_or("no data provider")?;
+                let info = CGBitmapInfo(
+                    CGImageAlphaInfo::PremultipliedFirst.0 | CGImageComponentInfo::Integer.0 | CGImageByteOrderInfo::Order32Little.0 | CGImagePixelFormatInfo::Packed.0,
+                );
+                let space = CGColorSpace::new_device_rgb().ok_or("no colour space")?;
+                let image = unsafe {
+                    CGImage::new(w, h, 8, 32, w * 4, Some(&space), info, Some(&provider), std::ptr::null(), false, CGColorRenderingIntent::RenderingIntentDefault)
+                }
+                .ok_or("no image")?;
+                let mask = CALayer::new();
+                mask.setFrame(layer.bounds());
+                unsafe { mask.setContents(Some(image.as_ref())) };
+                unsafe { layer.setMask(Some(&mask)) };
+            }
+        }
+        CATransaction::commit();
+        // The window's shadow is drawn from its pixels; ask for it again.
+        let ns_window: Option<Retained<AnyObject>> = unsafe { msg_send![view, window] };
+        if let Some(ns_window) = ns_window {
+            let _: () = unsafe { msg_send![&*ns_window, invalidateShadow] };
+        }
+        Ok(())
+    }
+}
